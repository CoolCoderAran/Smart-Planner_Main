# Flask Security Setup
SECRET_KEY=your_secure_random_flask_secret_key_here
FLASK_ENV=development

# Database Path (Optional override)
DATABASE_PATH=backend/database.db

# OpenAI API Setup
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Google OAuth 2.0 Integration Setup
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/calendar/google/callback
